{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_6bf4b7ba15654c28b0681316","type":"tool_result","content":"1\timport Foundation\n2\timport SwiftUI\n3\timport SwiftData\n4\t\n5\t@MainActor\n6\tfinal class ReminderFeedViewModel: ObservableObject {\n7\t    @Published var reminders: [ReminderItem] = []\n8\t    @Published var isLoading = false\n9\t\n10\t    private let contextEngine = ContextEngine.shared\n11\t    private let liveActivityService = LiveActivityService.shared\n12\t    private let notificationService = NotificationService.shared\n13\t\n14\t    private var modelContext: ModelContext?\n15\t\n16\t    func setup(modelContext: ModelContext) {\n17\t        self.modelContext = modelContext\n18\t        fetchReminders()\n19\t    }\n20\t\n21\t    func fetchReminders() {\n22\t        guard let modelContext else { return }\n23\t\n24\t        let descriptor = FetchDescriptor<ReminderItem>(\n25\t            sortBy: [SortDescriptor(\\.timestamp, order: .reverse)]\n26\t        )\n27\t\n28\t        do {\n29\t            reminders = try modelContext.fetch(descriptor)\n30\t        } catch {\n31\t            print(\"Failed to fetch reminders: \\(error)\")\n32\t        }\n33\t    }\n34\t\n35\t    /// 生成一条新提醒并保存\n36\t    func generateNewReminder() {\n37\t        guard let modelContext else { return }\n38\t\n39\t        let result = contextEngine.generate()\n40\t        let item = ReminderItem(\n41\t            text: result.text,\n42\t            category: result.category,\n43\t            timestamp: .now,\n44\t            isRead: false,\n45\t            isSmallNote: result.isSmallNote\n46\t        )\n47\t\n48\t        modelContext.insert(item)\n49\t\n50\t        do {\n51\t            try modelContext.save()\n52\t            fetchReminders()\n53\t            // 灵动岛分级策略：仅 .liveActivity 级别推灵动岛\n54\t            if result.displayPriority == .liveActivity {\n55\t                updateLiveActivity(with: item)\n56\t            }\n57\t        } catch {\n58\t            print(\"Failed to save reminder: \\(error)\")\n59\t        }\n60\t    }\n61\t\n62\t    /// 生成一天的模拟提醒\n63\t    func generateDailyReminders() {\n64\t        guard let modelContext else { return }\n65\t\n66\t        let results = mockEngine.generateDailyReminders()\n67\t\n68\t        for (index, result) in results.enumerated() {\n69\t            // 将时间分散在当天内\n70\t            let hour = 8 + index * 3\n71\t            let components = DateComponents(hour: min(hour, 21), minute: Int.random(in: 0...59))\n72\t            let timestamp = Calendar.current.date(from: components) ?? .now\n73\t\n74\t            let item = ReminderItem(\n75\t                text: result.text,\n76\t                category: result.category,\n77\t                timestamp: timestamp,\n78\t                isRead: false,\n79\t                isSmallNote: result.isSmallNote\n80\t            )\n81\t            modelContext.insert(item)\n82\t        }\n83\t\n84\t        do {\n85\t            try modelContext.save()\n86\t            fetchReminders()\n87\t\n88\t            // 用最新的提醒更新灵动岛\n89\t            if let latest = reminders.first {\n90\t                updateLiveActivity(with: latest)\n91\t            }\n92\t        } catch {\n93\t            print(\"Failed to save daily reminders: \\(error)\")\n94\t        }\n95\t    }\n96\t\n97\t    /// 标记为已读\n98\t    func markAsRead(_ item: ReminderItem) {\n99\t        item.isRead = true\n100\t        saveContext()\n101\t    }\n102\t\n103\t    /// 删除提醒\n104\t    func deleteReminder(_ item: ReminderItem) {\n105\t        guard let modelContext else { return }\n106\t        modelContext.delete(item)\n107\t        saveContext()\n108\t        fetchReminders()\n109\t    }\n110\t\n111\t    /// 设置反馈类型\n112\t    func setFeedback(_ item: ReminderItem, type: String) {\n113\t        item.feedbackType = type\n114\t        saveContext()\n115\t\n116\t        // V1.1: 通过 PreferenceLearner 学习用户偏好\n117\t        let learner = PreferenceLearner.shared\n118\t        learner.processFeedback(type)\n119\t        learner.recordCategoryFeedback(\n120\t            category: item.category.displayName,\n121\t            positive: type == \"positive\" || type == \"thumbUp\"\n122\t        )\n123\t        learner.recordActiveHour(Calendar.current.component(.hour, from: .now))\n124\t    }\n125\t\n126\t    // MARK: - Private\n127\t\n128\t    private func updateLiveActivity(with item: ReminderItem) {\n129\t        liveActivityService.updateLiveActivity(reminderText: item.text)\n130\t    }\n131\t\n132\t    private func saveContext() {\n133\t        guard let modelContext else { return }\n134\t        do {\n135\t            try modelContext.save()\n136\t        } catch {\n137\t            print(\"Failed to save context: \\(error)\")\n138\t        }\n139\t    }\n140\t}\n141\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"33d24eb8-fca9-4f18-9721-28897c4bbc1b","uuid":"6247da96-75a2-450c-9a48-73af9d49ca94","timestamp":"2026-05-06T09:59:49.457Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/hanhang/Desktop/work/home/developer/dforget/RemindMe/ViewModels/ReminderFeedViewModel.swift","content":"import Foundation\nimport SwiftUI\nimport SwiftData\n\n@MainActor\nfinal class ReminderFeedViewModel: ObservableObject {\n    @Published var reminders: [ReminderItem] = []\n    @Published var isLoading = false\n\n    private let contextEngine = ContextEngine.shared\n    private let liveActivityService = LiveActivityService.shared\n    private let notificationService = NotificationService.shared\n\n    private var modelContext: ModelContext?\n\n    func setup(modelContext: ModelContext) {\n        self.modelContext = modelContext\n        fetchReminders()\n    }\n\n    func fetchReminders() {\n        guard let modelContext else { return }\n\n        let descriptor = FetchDescriptor<ReminderItem>(\n            sortBy: [SortDescriptor(\\.timestamp, order: .reverse)]\n        )\n\n        do {\n            reminders = try modelContext.fetch(descriptor)\n        } catch {\n            print(\"Failed to fetch reminders: \\(error)\")\n        }\n    }\n\n    /// 生成一条新提醒并保存\n    func generateNewReminder() {\n        guard let modelContext else { return }\n\n        let result = contextEngine.generate()\n        let item = ReminderItem(\n            text: result.text,\n            category: result.category,\n            timestamp: .now,\n            isRead: false,\n            isSmallNote: result.isSmallNote\n        )\n\n        modelContext.insert(item)\n\n        do {\n            try modelContext.save()\n            fetchReminders()\n            // 灵动岛分级策略：仅 .liveActivity 级别推灵动岛\n            if result.displayPriority == .liveActivity {\n                updateLiveActivity(with: item)\n            }\n        } catch {\n            print(\"Failed to save reminder: \\(error)\")\n        }\n    }\n\n    /// 生成一天的模拟提醒\n    func generateDailyReminders() {\n        guard let modelContext else { return }\n\n        let results = mockEngine.generateDailyReminders()\n\n        for (index, result) in results.enumerated() {\n            // 将时间分散在当天内\n            let hour = 8 + index * 3\n            let components = DateComponents(hour: min(hour, 21), minute: Int.random(in: 0...59))\n            let timestamp = Calendar.current.date(from: components) ?? .now\n\n            let item = ReminderItem(\n                text: result.text,\n                category: result.category,\n                timestamp: timestamp,\n                isRead: false,\n                isSmallNote: result.isSmallNote\n            )\n            modelContext.insert(item)\n        }\n\n        do {\n            try modelContext.save()\n            fetchReminders()\n\n            // 用最新的提醒更新灵动岛\n            if let latest = reminders.first {\n                updateLiveActivity(with: latest)\n            }\n        } catch {\n            print(\"Failed to save daily reminders: \\(error)\")\n        }\n    }\n\n    /// 标记为已读\n    func markAsRead(_ item: ReminderItem) {\n        item.isRead = true\n        saveContext()\n    }\n\n    /// 删除提醒\n    func deleteReminder(_ item: ReminderItem) {\n        guard let modelContext else { return }\n        modelContext.delete(item)\n        saveContext()\n        fetchReminders()\n    }\n\n    /// 设置反馈类型\n    func setFeedback(_ item: ReminderItem, type: String) {\n        item.feedbackType = type\n        saveContext()\n\n        // V1.1: 通过 PreferenceLearner 学习用户偏好\n        let learner = PreferenceLearner.shared\n        learner.processFeedback(type)\n        learner.recordCategoryFeedback(\n            category: item.category.displayName,\n            positive: type == \"positive\" || type == \"thumbUp\"\n        )\n        learner.recordActiveHour(Calendar.current.component(.hour, from: .now))\n    }\n\n    // MARK: - Private\n\n    private func updateLiveActivity(with item: ReminderItem) {\n        liveActivityService.updateLiveActivity(reminderText: item.text)\n    }\n\n    private func saveContext() {\n        guard let modelContext else { return }\n        do {\n            try modelContext.save()\n        } catch {\n            print(\"Failed to save context: \\(error)\")\n        }\n    }\n}\n","numLines":141,"startLine":1,"totalLines":141}}}
