{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_d2d7f84264f34957a253013e","type":"tool_result","content":"1\timport Foundation\n2\t\n3\t// TODO: AI Integration — 接入真实 AI 模型生成个性化提醒内容\n4\t// 目前使用本地模板随机生成模拟提醒\n5\t\n6\tfinal class MockReminderEngine {\n7\t    static let shared = MockReminderEngine()\n8\t\n9\t    private init() {}\n10\t\n11\t    // MARK: - 天气提醒\n12\t\n13\t    private let weatherReminders = [\n14\t        \"今天气温变化较大，出门记得带件外套。\",\n15\t        \"下午可能有阵雨，记得带伞。\",\n16\t        \"空气质量不错，适合户外活动。\",\n17\t        \"今晚温度会降到 10°C 以下，注意保暖。\",\n18\t        \"紫外线指数偏高，出门注意防晒。\",\n19\t        \"明天多云转晴，是个出门的好天气。\",\n20\t        \"湿度较高，衣服不容易晾干。\",\n21\t        \"今天风比较大，骑行注意安全。\",\n22\t    ]\n23\t\n24\t    // MARK: - 日历提醒\n25\t\n26\t    private let calendarReminders = [\n27\t        \"今天有个会议别忘了准备材料。\",\n28\t        \"距离下一个日程还有一小时，提前准备。\",\n29\t        \"今天的事比较多，记得合理分配时间。\",\n30\t        \"下午有个待办事项即将到期。\",\n31\t        \"今天的日程已经排满了，注意节奏。\",\n32\t        \"会议结束后记得整理纪要。\",\n33\t    ]\n34\t\n35\t    // MARK: - 时间提醒\n36\t\n37\t    private let timeReminders = [\n38\t        \"站起来活动一下，久坐对身体不好。\",\n39\t        \"该喝水了，保持每天八杯水的好习惯。\",\n40\t        \"中午了，记得吃午饭。\",\n41\t        \"下午容易犯困，可以站起来走走。\",\n42\t        \"一天过半了，检查一下待办清单。\",\n43\t        \"快到下班时间了，整理一下今天的工作。\",\n44\t        \"晚上早点休息，明天还有新的开始。\",\n45\t        \"现在是下午茶时间，适当放松一下。\",\n46\t        \"别忘了做几分钟深呼吸，缓解压力。\",\n47\t        \"该保护眼睛了，看看远处休息一下。\",\n48\t    ]\n49\t\n50\t    // MARK: - 日常提醒（小纸条）\n51\t\n52\t    private let smallNoteReminders = [\n53\t        \"你今天做得很好，继续保持。\",\n54\t        \"生活不是比赛，偶尔慢下来也没关系。\",\n55\t        \"别忘了给家人打个电话。\",\n56\t        \"今天有什么值得开心的小事吗？\",\n57\t        \"试着对陌生人微笑一下。\",\n58\t        \"你已经很努力了，不要对自己太苛刻。\",\n59\t        \"给自己买杯好喝的咖啡吧。\",\n60\t        \"记录下今天的一个小成就。\",\n61\t    ]\n62\t\n63\t    // MARK: - 生成逻辑\n64\t\n65\t    /// 根据当前时间段生成合适的提醒\n66\t    /// 小纸条：每周最多 1 条，不重复\n67\t    /// V1.1: 根据用户偏好过滤不受欢迎的类别\n68\t    func generateReminder() -> (text: String, category: ReminderCategory, isSmallNote: Bool) {\n69\t        let hour = Calendar.current.component(.hour, from: .now)\n70\t\n71\t        // 检查推送是否暂停（信号值过低）\n72\t        if PreferenceLearner.shared.isPushPaused {\n73\t            // 暂停期间只生成小纸条（非打扰）\n74\t            return (\n75\t                text: pickUniqueSmallNote(),\n76\t                category: .general,\n77\t                isSmallNote: true\n78\t            )\n79\t        }\n80\t\n81\t        // 小纸条逻辑：每周最多 1 条，概率约 5%\n82\t        let isSmallNote = shouldGenerateSmallNote()\n83\t\n84\t        if isSmallNote {\n85\t            return (\n86\t                text: pickUniqueSmallNote(),\n87\t                category: .general,\n88\t                isSmallNote: true\n89\t            )\n90\t        }\n91\t\n92\t        // 根据时间段优先生成不同类别\n93\t        let category: ReminderCategory\n94\t        if hour >= 7 && hour < 10 {\n95\t            // 早晨 — 天气 + 日历\n96\t            category = Bool.random() ? .weather : .calendar\n97\t        } else if hour >= 10 && hour < 12 {\n98\t            // 上午 — 时间提醒\n99\t            category = .time\n100\t        } else if hour >= 12 && hour < 14 {\n101\t            // 中午 — 时间提醒\n102\t            category = .time\n103\t        } else if hour >= 14 && hour < 18 {\n104\t            // 下午 — 混合\n105\t            category = [.time, .calendar, .weather].randomElement()!\n106\t        } else if hour >= 18 && hour < 22 {\n107\t            // 晚上 — 小纸条概率提高\n108\t            if Bool.random() {\n109\t                return (\n110\t                    text: smallNoteReminders.randomElement()!,\n111\t                    category: .general,\n112\t                    isSmallNote: true\n113\t                )\n114\t            }\n115\t            category = .time\n116\t        } else {\n117\t            // 深夜 — 安慰型\n118\t            return (\n119\t                text: \"夜深了，早点休息吧。明天会更好。\",\n120\t                category: .general,\n121\t                isSmallNote: true\n122\t            )\n123\t        }\n124\t\n125\t        let text: String\n126\t        switch category {\n127\t        case .weather:\n128\t            text = weatherReminders.randomElement()!\n129\t        case .calendar:\n130\t            text = calendarReminders.randomElement()!\n131\t        case .time:\n132\t            text = timeReminders.randomElement()!\n133\t        case .general:\n134\t            text = smallNoteReminders.randomElement()!\n135\t        }\n136\t\n137\t        return (text: text, category: category, isSmallNote: false)\n138\t    }\n139\t\n140\t    /// 每天生成 4~6 条提醒\n141\t    func generateDailyReminders() -> [(text: String, category: ReminderCategory, isSmallNote: Bool)] {\n142\t        let count = Int.random(in: 4...6)\n143\t        var reminders: [(text: String, category: ReminderCategory, isSmallNote: Bool)] = []\n144\t\n145\t        for _ in 0..<count {\n146\t            reminders.append(generateReminder())\n147\t        }\n148\t\n149\t        return reminders\n150\t    }\n151\t\n152\t    // MARK: - 小纸条控制\n153\t\n154\t    private let smallNoteKey = \"lastSmallNoteWeek\"\n155\t    private var lastSmallNoteWeek: Int {\n156\t        let defaults = UserDefaults.standard\n157\t        return defaults.integer(forKey: smallNoteKey)\n158\t    }\n159\t\n160\t    private func currentWeekOfYear() -> Int {\n161\t        let calendar = Calendar.current\n162\t        return calendar.component(.weekOfYear, from: .now)\n163\t    }\n164\t\n165\t    /// 每周最多 1 条小纸条，概率约 5%\n166\t    private func shouldGenerateSmallNote() -> Bool {\n167\t        let currentWeek = currentWeekOfYear()\n168\t        guard lastSmallNoteWeek != currentWeek else { return false }\n169\t        return Int.random(in: 0..<100) < 5\n170\t    }\n171\t\n172\t    /// 从小纸条池中随机选一条，尽量避免短期重复\n173\t    private func pickUniqueSmallNote() -> String {\n174\t        let defaults = UserDefaults.standard\n175\t        let lastNote = defaults.string(forKey: \"lastSmallNoteText\") ?? \"\"\n176\t\n177\t        var candidates = smallNoteReminders.filter { $0 != lastNote }\n178\t        if candidates.isEmpty { candidates = smallNoteReminders }\n179\t\n180\t        let note = candidates.randomElement()!\n181\t        defaults.set(note, forKey: \"lastSmallNoteText\")\n182\t        defaults.set(currentWeekOfYear(), forKey: smallNoteKey)\n183\t        return note\n184\t    }\n185\t}\n186\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"33d24eb8-fca9-4f18-9721-28897c4bbc1b","uuid":"bc307f8e-8f81-4819-a3de-cb745175cdd9","timestamp":"2026-05-06T09:56:44.098Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/hanhang/Desktop/work/home/developer/dforget/RemindMe/Services/MockReminderEngine.swift","content":"import Foundation\n\n// TODO: AI Integration — 接入真实 AI 模型生成个性化提醒内容\n// 目前使用本地模板随机生成模拟提醒\n\nfinal class MockReminderEngine {\n    static let shared = MockReminderEngine()\n\n    private init() {}\n\n    // MARK: - 天气提醒\n\n    private let weatherReminders = [\n        \"今天气温变化较大，出门记得带件外套。\",\n        \"下午可能有阵雨，记得带伞。\",\n        \"空气质量不错，适合户外活动。\",\n        \"今晚温度会降到 10°C 以下，注意保暖。\",\n        \"紫外线指数偏高，出门注意防晒。\",\n        \"明天多云转晴，是个出门的好天气。\",\n        \"湿度较高，衣服不容易晾干。\",\n        \"今天风比较大，骑行注意安全。\",\n    ]\n\n    // MARK: - 日历提醒\n\n    private let calendarReminders = [\n        \"今天有个会议别忘了准备材料。\",\n        \"距离下一个日程还有一小时，提前准备。\",\n        \"今天的事比较多，记得合理分配时间。\",\n        \"下午有个待办事项即将到期。\",\n        \"今天的日程已经排满了，注意节奏。\",\n        \"会议结束后记得整理纪要。\",\n    ]\n\n    // MARK: - 时间提醒\n\n    private let timeReminders = [\n        \"站起来活动一下，久坐对身体不好。\",\n        \"该喝水了，保持每天八杯水的好习惯。\",\n        \"中午了，记得吃午饭。\",\n        \"下午容易犯困，可以站起来走走。\",\n        \"一天过半了，检查一下待办清单。\",\n        \"快到下班时间了，整理一下今天的工作。\",\n        \"晚上早点休息，明天还有新的开始。\",\n        \"现在是下午茶时间，适当放松一下。\",\n        \"别忘了做几分钟深呼吸，缓解压力。\",\n        \"该保护眼睛了，看看远处休息一下。\",\n    ]\n\n    // MARK: - 日常提醒（小纸条）\n\n    private let smallNoteReminders = [\n        \"你今天做得很好，继续保持。\",\n        \"生活不是比赛，偶尔慢下来也没关系。\",\n        \"别忘了给家人打个电话。\",\n        \"今天有什么值得开心的小事吗？\",\n        \"试着对陌生人微笑一下。\",\n        \"你已经很努力了，不要对自己太苛刻。\",\n        \"给自己买杯好喝的咖啡吧。\",\n        \"记录下今天的一个小成就。\",\n    ]\n\n    // MARK: - 生成逻辑\n\n    /// 根据当前时间段生成合适的提醒\n    /// 小纸条：每周最多 1 条，不重复\n    /// V1.1: 根据用户偏好过滤不受欢迎的类别\n    func generateReminder() -> (text: String, category: ReminderCategory, isSmallNote: Bool) {\n        let hour = Calendar.current.component(.hour, from: .now)\n\n        // 检查推送是否暂停（信号值过低）\n        if PreferenceLearner.shared.isPushPaused {\n            // 暂停期间只生成小纸条（非打扰）\n            return (\n                text: pickUniqueSmallNote(),\n                category: .general,\n                isSmallNote: true\n            )\n        }\n\n        // 小纸条逻辑：每周最多 1 条，概率约 5%\n        let isSmallNote = shouldGenerateSmallNote()\n\n        if isSmallNote {\n            return (\n                text: pickUniqueSmallNote(),\n                category: .general,\n                isSmallNote: true\n            )\n        }\n\n        // 根据时间段优先生成不同类别\n        let category: ReminderCategory\n        if hour >= 7 && hour < 10 {\n            // 早晨 — 天气 + 日历\n            category = Bool.random() ? .weather : .calendar\n        } else if hour >= 10 && hour < 12 {\n            // 上午 — 时间提醒\n            category = .time\n        } else if hour >= 12 && hour < 14 {\n            // 中午 — 时间提醒\n            category = .time\n        } else if hour >= 14 && hour < 18 {\n            // 下午 — 混合\n            category = [.time, .calendar, .weather].randomElement()!\n        } else if hour >= 18 && hour < 22 {\n            // 晚上 — 小纸条概率提高\n            if Bool.random() {\n                return (\n                    text: smallNoteReminders.randomElement()!,\n                    category: .general,\n                    isSmallNote: true\n                )\n            }\n            category = .time\n        } else {\n            // 深夜 — 安慰型\n            return (\n                text: \"夜深了，早点休息吧。明天会更好。\",\n                category: .general,\n                isSmallNote: true\n            )\n        }\n\n        let text: String\n        switch category {\n        case .weather:\n            text = weatherReminders.randomElement()!\n        case .calendar:\n            text = calendarReminders.randomElement()!\n        case .time:\n            text = timeReminders.randomElement()!\n        case .general:\n            text = smallNoteReminders.randomElement()!\n        }\n\n        return (text: text, category: category, isSmallNote: false)\n    }\n\n    /// 每天生成 4~6 条提醒\n    func generateDailyReminders() -> [(text: String, category: ReminderCategory, isSmallNote: Bool)] {\n        let count = Int.random(in: 4...6)\n        var reminders: [(text: String, category: ReminderCategory, isSmallNote: Bool)] = []\n\n        for _ in 0..<count {\n            reminders.append(generateReminder())\n        }\n\n        return reminders\n    }\n\n    // MARK: - 小纸条控制\n\n    private let smallNoteKey = \"lastSmallNoteWeek\"\n    private var lastSmallNoteWeek: Int {\n        let defaults = UserDefaults.standard\n        return defaults.integer(forKey: smallNoteKey)\n    }\n\n    private func currentWeekOfYear() -> Int {\n        let calendar = Calendar.current\n        return calendar.component(.weekOfYear, from: .now)\n    }\n\n    /// 每周最多 1 条小纸条，概率约 5%\n    private func shouldGenerateSmallNote() -> Bool {\n        let currentWeek = currentWeekOfYear()\n        guard lastSmallNoteWeek != currentWeek else { return false }\n        return Int.random(in: 0..<100) < 5\n    }\n\n    /// 从小纸条池中随机选一条，尽量避免短期重复\n    private func pickUniqueSmallNote() -> String {\n        let defaults = UserDefaults.standard\n        let lastNote = defaults.string(forKey: \"lastSmallNoteText\") ?? \"\"\n\n        var candidates = smallNoteReminders.filter { $0 != lastNote }\n        if candidates.isEmpty { candidates = smallNoteReminders }\n\n        let note = candidates.randomElement()!\n        defaults.set(note, forKey: \"lastSmallNoteText\")\n        defaults.set(currentWeekOfYear(), forKey: smallNoteKey)\n        return note\n    }\n}\n","numLines":186,"startLine":1,"totalLines":186}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_40e028078eb24dde8733a6a0","type":"tool_result","content":"1\timport Foundation\n2\t\n3\t/// V1.1: 用户偏好学习引擎\n4\t/// 根据用户反馈动态调整提醒策略\n5\t/// TODO: AI Integration — V2.0 接入 LLM 做更精准的偏好推断\n6\t\n7\tfinal class PreferenceLearner {\n8\t    static let shared = PreferenceLearner()\n9\t\n10\t    private let defaults = UserDefaults.standard\n11\t\n12\t    // MARK: - 信号值\n13\t\n14\t    /// 信号值范围 -1.0 到 +1.0\n15\t    var signalValue: Double {\n16\t        get { defaults.double(forKey: \"signal_value\") }\n17\t        set { defaults.set(newValue, forKey: \"signal_value\") }\n18\t    }\n19\t\n20\t    /// 信号值暂停阈值\n21\t    static let pauseThreshold = 0.10\n22\t    /// 信号值恢复阈值\n23\t    static let resumeThreshold = 0.30\n24\t\n25\t    /// 加权移动平均系数\n26\t    private let alpha: Double = 0.3\n27\t\n28\t    /// 是否暂停推送\n29\t    var isPushPaused: Bool {\n30\t        return signalValue < Self.pauseThreshold\n31\t    }\n32\t\n33\t    // MARK: - 反馈权重\n34\t\n35\t    enum FeedbackWeight {\n36\t        static let thumbUp: Double = 0.15\n37\t        static let thumbDown: Double = -0.25\n38\t        static let dismiss: Double = -0.10\n39\t        static let ignore: Double = 0.02      // 24h 无互动\n40\t        static let silence: Double = 0.05      // 沉默接受\n41\t    }\n42\t\n43\t    // MARK: - 更新信号值\n44\t\n45\t    /// 处理用户反馈\n46\t    func processFeedback(_ type: String) {\n47\t        let weight: Double\n48\t        switch type {\n49\t        case \"positive\", \"thumbUp\":\n50\t            weight = FeedbackWeight.thumbUp\n51\t        case \"negative\", \"thumbDown\":\n52\t            weight = FeedbackWeight.thumbDown\n53\t        case \"neutral\":\n54\t            weight = FeedbackWeight.silence\n55\t        default:\n56\t            weight = FeedbackWeight.silence\n57\t        }\n58\t\n59\t        updateSignal(delta: weight)\n60\t    }\n61\t\n62\t    /// 处理通知被忽略（24h 未互动）\n63\t    func processIgnored() {\n64\t        updateSignal(delta: FeedbackWeight.ignore)\n65\t    }\n66\t\n67\t    /// 更新信号值（加权移动平均）\n68\t    private func updateSignal(delta: Double) {\n69\t        let prev = signalValue == 0 ? 0.5 : signalValue\n70\t        let next = prev + alpha * (delta - prev)\n71\t        let clamped = max(-1.0, min(1.0, next))\n72\t        signalValue = clamped\n73\t\n74\t        print(\"[PreferenceLearner] Signal: \\(prev) → \\(clamped) (delta=\\(delta))\")\n75\t\n76\t        if clamped < Self.pauseThreshold {\n77\t            print(\"[PreferenceLearner] Push PAUSED\")\n78\t        } else if clamped >= Self.resumeThreshold {\n79\t            print(\"[PreferenceLearner] Push RESUMED\")\n80\t        }\n81\t    }\n82\t\n83\t    // MARK: - 类别偏好\n84\t\n85\t    /// 记录各类别的反馈得分\n86\t    func recordCategoryFeedback(category: String, positive: Bool) {\n87\t        let key = \"category_score_\\(category)\"\n88\t        let current = defaults.double(forKey: key)\n89\t        let delta = positive ? 0.1 : -0.15\n90\t        let next = max(-1.0, min(1.0, current + delta))\n91\t        defaults.set(next, forKey: key)\n92\t    }\n93\t\n94\t    /// 获取类别偏好（得分从高到低排序）\n95\t    func getSortedCategories() -> [(category: String, score: Double)] {\n96\t        let allCategories = [\"weather\", \"calendar\", \"time\", \"health\", \"general\"]\n97\t        var scored: [(category: String, score: Double)] = []\n98\t\n99\t        for cat in allCategories {\n100\t            let score = defaults.double(forKey: \"category_score_\\(cat)\")\n101\t            scored.append((category: cat, score: score))\n102\t        }\n103\t\n104\t        return scored.sorted { $0.score > $1.score }\n105\t    }\n106\t\n107\t    /// 获取最低偏好类别（避免频繁推送）\n108\t    func getDislikedCategories() -> [String] {\n109\t        getSortedCategories()\n110\t            .filter { $0.score < -0.3 }\n111\t            .map { $0.category }\n112\t    }\n113\t\n114\t    // MARK: - 时段偏好\n115\t\n116\t    /// 记录哪个时段用户活跃（点击/阅读提醒）\n117\t    func recordActiveHour(_ hour: Int) {\n118\t        let key = \"active_hour_\\(hour)\"\n119\t        let count = defaults.integer(forKey: key)\n120\t        defaults.set(count + 1, forKey: key)\n121\t    }\n122\t\n123\t    /// 获取用户最活跃的小时\n124\t    func getTopActiveHours(limit: Int = 3) -> [Int] {\n125\t        var hours: [(hour: Int, count: Int)] = []\n126\t\n127\t        for h in 0..<24 {\n128\t            let count = defaults.integer(forKey: \"active_hour_\\(h)\")\n129\t            if count > 0 {\n130\t                hours.append((hour: h, count: count))\n131\t            }\n132\t        }\n133\t\n134\t        return hours.sorted { $0.count > $1.count }.prefix(limit).map { $0.hour }\n135\t    }\n136\t\n137\t    // MARK: - 冷启动\n138\t\n139\t    /// 获取安装天数\n140\t    var daysSinceInstall: Int {\n141\t        let installDate = defaults.object(forKey: \"install_date\") as? Date ?? Date()\n142\t        let days = Calendar.current.dateComponents([.day], from: installDate, to: Date()).day ?? 0\n143\t        return max(days, 0)\n144\t    }\n145\t\n146\t    /// 获取冷启动阶段\n147\t    var coldStartPhase: ColdStartPhase {\n148\t        let days = daysSinceInstall\n149\t        if days <= 3 { return .conservative }\n150\t        if days <= 7 { return .exploring }\n151\t        return .normal\n152\t    }\n153\t\n154\t    /// 冷启动阶段对应的每日推送上限\n155\t    var dailyPushLimit: Int {\n156\t        switch coldStartPhase {\n157\t        case .conservative: return 3\n158\t        case .exploring: return 5\n159\t        case .normal: return 6\n160\t        }\n161\t    }\n162\t\n163\t    enum ColdStartPhase: String {\n164\t        case conservative = \"Day 1-3: 保守期\"\n165\t        case exploring = \"Day 4-7: 试探期\"\n166\t        case normal = \"Day 8+: 正常期\"\n167\t    }\n168\t}\n169\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"33d24eb8-fca9-4f18-9721-28897c4bbc1b","uuid":"68877497-f759-4454-8412-ce6a6ca89099","timestamp":"2026-05-06T09:56:44.099Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/hanhang/Desktop/work/home/developer/dforget/RemindMe/Services/PreferenceLearner.swift","content":"import Foundation\n\n/// V1.1: 用户偏好学习引擎\n/// 根据用户反馈动态调整提醒策略\n/// TODO: AI Integration — V2.0 接入 LLM 做更精准的偏好推断\n\nfinal class PreferenceLearner {\n    static let shared = PreferenceLearner()\n\n    private let defaults = UserDefaults.standard\n\n    // MARK: - 信号值\n\n    /// 信号值范围 -1.0 到 +1.0\n    var signalValue: Double {\n        get { defaults.double(forKey: \"signal_value\") }\n        set { defaults.set(newValue, forKey: \"signal_value\") }\n    }\n\n    /// 信号值暂停阈值\n    static let pauseThreshold = 0.10\n    /// 信号值恢复阈值\n    static let resumeThreshold = 0.30\n\n    /// 加权移动平均系数\n    private let alpha: Double = 0.3\n\n    /// 是否暂停推送\n    var isPushPaused: Bool {\n        return signalValue < Self.pauseThreshold\n    }\n\n    // MARK: - 反馈权重\n\n    enum FeedbackWeight {\n        static let thumbUp: Double = 0.15\n        static let thumbDown: Double = -0.25\n        static let dismiss: Double = -0.10\n        static let ignore: Double = 0.02      // 24h 无互动\n        static let silence: Double = 0.05      // 沉默接受\n    }\n\n    // MARK: - 更新信号值\n\n    /// 处理用户反馈\n    func processFeedback(_ type: String) {\n        let weight: Double\n        switch type {\n        case \"positive\", \"thumbUp\":\n            weight = FeedbackWeight.thumbUp\n        case \"negative\", \"thumbDown\":\n            weight = FeedbackWeight.thumbDown\n        case \"neutral\":\n            weight = FeedbackWeight.silence\n        default:\n            weight = FeedbackWeight.silence\n        }\n\n        updateSignal(delta: weight)\n    }\n\n    /// 处理通知被忽略（24h 未互动）\n    func processIgnored() {\n        updateSignal(delta: FeedbackWeight.ignore)\n    }\n\n    /// 更新信号值（加权移动平均）\n    private func updateSignal(delta: Double) {\n        let prev = signalValue == 0 ? 0.5 : signalValue\n        let next = prev + alpha * (delta - prev)\n        let clamped = max(-1.0, min(1.0, next))\n        signalValue = clamped\n\n        print(\"[PreferenceLearner] Signal: \\(prev) → \\(clamped) (delta=\\(delta))\")\n\n        if clamped < Self.pauseThreshold {\n            print(\"[PreferenceLearner] Push PAUSED\")\n        } else if clamped >= Self.resumeThreshold {\n            print(\"[PreferenceLearner] Push RESUMED\")\n        }\n    }\n\n    // MARK: - 类别偏好\n\n    /// 记录各类别的反馈得分\n    func recordCategoryFeedback(category: String, positive: Bool) {\n        let key = \"category_score_\\(category)\"\n        let current = defaults.double(forKey: key)\n        let delta = positive ? 0.1 : -0.15\n        let next = max(-1.0, min(1.0, current + delta))\n        defaults.set(next, forKey: key)\n    }\n\n    /// 获取类别偏好（得分从高到低排序）\n    func getSortedCategories() -> [(category: String, score: Double)] {\n        let allCategories = [\"weather\", \"calendar\", \"time\", \"health\", \"general\"]\n        var scored: [(category: String, score: Double)] = []\n\n        for cat in allCategories {\n            let score = defaults.double(forKey: \"category_score_\\(cat)\")\n            scored.append((category: cat, score: score))\n        }\n\n        return scored.sorted { $0.score > $1.score }\n    }\n\n    /// 获取最低偏好类别（避免频繁推送）\n    func getDislikedCategories() -> [String] {\n        getSortedCategories()\n            .filter { $0.score < -0.3 }\n            .map { $0.category }\n    }\n\n    // MARK: - 时段偏好\n\n    /// 记录哪个时段用户活跃（点击/阅读提醒）\n    func recordActiveHour(_ hour: Int) {\n        let key = \"active_hour_\\(hour)\"\n        let count = defaults.integer(forKey: key)\n        defaults.set(count + 1, forKey: key)\n    }\n\n    /// 获取用户最活跃的小时\n    func getTopActiveHours(limit: Int = 3) -> [Int] {\n        var hours: [(hour: Int, count: Int)] = []\n\n        for h in 0..<24 {\n            let count = defaults.integer(forKey: \"active_hour_\\(h)\")\n            if count > 0 {\n                hours.append((hour: h, count: count))\n            }\n        }\n\n        return hours.sorted { $0.count > $1.count }.prefix(limit).map { $0.hour }\n    }\n\n    // MARK: - 冷启动\n\n    /// 获取安装天数\n    var daysSinceInstall: Int {\n        let installDate = defaults.object(forKey: \"install_date\") as? Date ?? Date()\n        let days = Calendar.current.dateComponents([.day], from: installDate, to: Date()).day ?? 0\n        return max(days, 0)\n    }\n\n    /// 获取冷启动阶段\n    var coldStartPhase: ColdStartPhase {\n        let days = daysSinceInstall\n        if days <= 3 { return .conservative }\n        if days <= 7 { return .exploring }\n        return .normal\n    }\n\n    /// 冷启动阶段对应的每日推送上限\n    var dailyPushLimit: Int {\n        switch coldStartPhase {\n        case .conservative: return 3\n        case .exploring: return 5\n        case .normal: return 6\n        }\n    }\n\n    enum ColdStartPhase: String {\n        case conservative = \"Day 1-3: 保守期\"\n        case exploring = \"Day 4-7: 试探期\"\n        case normal = \"Day 8+: 正常期\"\n    }\n}\n","numLines":169,"startLine":1,"totalLines":169}}}
